{
  "name": "mytv-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interface web de navigation et lecture pour le service mytv (API /api/v1)",
  "scripts": {
    "dev": "NODE_OPTIONS=--tls-max-v1.2 vite",
    "build": "tsc --noEmit && NODE_OPTIONS=--tls-max-v1.2 vite build",
    "preview": "NODE_OPTIONS=--tls-max-v1.2 vite preview",
    "check": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs && node tests/unit/lancer.mjs",
    "test:e2e": "node tests/e2e/us19.mjs && node tests/e2e/us20-lecture.mjs && node tests/e2e/us21-guide.mjs && node tests/e2e/us28.mjs && node tests/e2e/us32.mjs && node tests/e2e/us35.mjs",
    "test:harnais": "node tests/e2e/us19-harnais.mjs && node tests/e2e/us28-harnais.mjs",
    "test:fournisseur": "node tests/e2e/us25-fournisseur.mjs",
    "test:recette": "node tests/e2e/us22-recette.mjs",
    "test:dist": "node tests/dist-sans-secrets.mjs"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "@tanstack/solid-query": "^5.104.2",
    "@tanstack/solid-virtual": "^3.13.42",
    "@types/node": "^26.6.5",
    "dexie": "^4.4.6",
    "hls.js": "^1.7.3",
    "minisearch": "^7.2.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
